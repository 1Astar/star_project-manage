{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "cloudflare-worker.ts",
  "name": "star-pm",
  "minify": true,
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "star-pm"
    }
  ],
  "triggers": {
    "crons": [
      "0 1 * * *",
      "30 10 * * *",
      "0 10 * * *",
      "0 11 * * *"
    ]
  },
  // 控制台 Variables 以 Dashboard 为准，避免下次 deploy 用仓库里空的 vars 覆盖掉
  "keep_vars": true,
  "vars": {
    "NEXT_PUBLIC_CF_WORKER": "1"
  },
  // Free 套餐不支持 limits.cpu_ms（API 100328）；升级 Paid 后再加，例如 "cpu_ms": 60000
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
